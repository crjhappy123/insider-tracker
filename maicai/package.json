{
  "name": "maicai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "监控 Fred Meyer / Trader Joe's / 99 Ranch / T&T 的菜价，做单价比价和促销推荐",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "ingest": "node src/ingest.js",
    "ingest:sample": "node src/ingest.js --stores=all --source=sample",
    "seed-history": "node src/ingest.js --seed-history",
    "reset": "node -e \"import('node:fs').then(f=>{f.rmSync('data/maicai.db',{force:true});console.log('数据库已删除')})\"",
    "ingest:flyers": "node src/ingest.js --stores=costco,boohan",
    "export": "node src/export.js",
    "history:dump": "node src/ingest.js --dump-history",
    "history:load": "node src/ingest.js --load-history"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "playwright": "^1.63.0"
  }
}
