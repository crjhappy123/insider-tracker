# 复制成 .env 再填。只有 Fred Meyer 需要凭证，另外三家不需要。

# Kroger 开发者凭证（Fred Meyer 的真实分店价格靠它）
# 免费申请：https://developer.kroger.com -> 注册 -> Add Product -> 拿 Client ID / Secret
# 配额默认每天 10,000 次，我们一天用几十次
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# 可选：直接指定 Fred Meyer 门店号，省得改 data/stores.json
# 用 `npm run ingest -- --find-stores` 查
KROGER_LOCATION_ID=

# 读促销单图片用（Costco 的月度优惠册、Boo Han 的周报）。
# 不设也能跑：那两家改成从 data/manual/<门店id>.json 手动录入。
# 也可以不用这个变量，改跑 `ant auth login`，SDK 会自动认。
ANTHROPIC_API_KEY=

# 可选：网页端口，默认 5173
# PORT=5173

# 可选：数据库位置，默认 data/maicai.db
# MAICAI_DB=

# 排查问题时设成 1，报错会打完整堆栈
# DEBUG=
